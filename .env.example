NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/murafiq
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_prod
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_prod
GOOGLE_CLIENT_ID=dev-google-client-id.apps.googleusercontent.com
CLOUDINARY_CLOUD_NAME=my_cloud_name
CLOUDINARY_API_KEY=my_api_key
CLOUDINARY_API_SECRET=my_api_secret
MAIL_PROVIDER=resend
RESEND_API_KEY=re_dev_key_change_me_in_prod
MAIL_FROM_ADDRESS=no-reply@murafiq.dev
# Dev-only: redirect ALL outgoing emails to this address (sandbox workaround). Remove before go-live.
MAIL_TO_ADDRESS=
# The FRONTEND origin — used for CORS and user-facing redirect links.
CLIENT_URL=http://localhost:3000
# This BACKEND's own public origin. Distinct from CLIENT_URL — payment webhooks must be delivered
# here, not to the frontend. In production this is the public API hostname.
API_URL=http://localhost:4000
FIREBASE_PROJECT_ID=murafiq-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@murafiq-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=dev_firebase_private_key_change_me_in_prod
# Phase 14: Redis & BullMQ queue connection
REDIS_URL=redis://127.0.0.1:6379

# Phase 14 & 15: Google Gemini Multimodal Vision & Reasoning
GEMINI_API_KEY=dev_gemini_api_key_placeholder

# Phase 14 & 15: Upstash Vector DB REST credentials
UPSTASH_VECTOR_REST_URL=https://dev-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=dev_upstash_vector_token_placeholder


#Payment provider configuration
# mock: only ever selected when NODE_ENV=test (see payment.service.js#getProvider). Use paymob for
# local/dev/staging so the real sandbox integration is actually exercised.
PAYMENT_PROVIDER=paymob
PLATFORM_FEE_PERCENTAGE=15
PAYMOB_SECRET_KEY=sk_test_placeholder
PAYMOB_PUBLIC_KEY=pk_test_placeholder
PAYMOB_HMAC_SECRET=dev_hmac_placeholder
PAYMOB_CARD_INTEGRATION_ID=123456
# Legacy api_key (Settings -> Account Info in the Paymob dashboard) — only used by refund()'s
# auth-token exchange. Distinct from PAYMOB_SECRET_KEY.
PAYMOB_API_KEY=paymob_legacy_api_key_placeholder
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_BASE_URL=https://accept.paymob.com
# Must be reachable BY Paymob's servers — i.e. this backend's public origin, not localhost, once
# deployed. Defaults to API_URL + the webhook route if unset.
PAYMOB_NOTIFICATION_URL=http://localhost:4000/api/v1/payments/callback
PAYMOB_REDIRECTION_URL=
# Required in NODE_ENV=test to exercise MockProvider's webhook signature check.
MOCK_WEBHOOK_SECRET=dev_mock_webhook_secret
